{
  "name": "extension-forge",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.1.0",
  "publisher": "ceslava",
  "author": {
    "name": "ceslava"
  },
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#3b2a6b",
    "theme": "dark"
  },
  "pricing": "Free",
  "repository": {
    "type": "git",
    "url": "https://github.com/ceslava/skills-vs-code-extensions.git",
    "directory": "mcp"
  },
  "bugs": {
    "url": "https://github.com/ceslava/skills-vs-code-extensions/issues"
  },
  "homepage": "https://github.com/ceslava/skills-vs-code-extensions/tree/main/mcp#readme",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "keywords": [
    "mcp",
    "ai",
    "claude",
    "copilot",
    "cursor",
    "extension",
    "generator",
    "scaffold",
    "i18n",
    "vsix"
  ],
  "l10n": "./l10n",
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "extensionForge.mcp",
        "label": "Extension Forge"
      }
    ],
    "commands": [
      {
        "command": "extensionForge.createExtension",
        "title": "%command.create%",
        "category": "Extension Forge"
      },
      {
        "command": "extensionForge.copyMcpConfig",
        "title": "%command.copyMcpConfig%",
        "category": "Extension Forge"
      },
      {
        "command": "extensionForge.setAuthor",
        "title": "%command.setAuthor%",
        "category": "Extension Forge"
      }
    ],
    "configuration": {
      "title": "Extension Forge",
      "properties": {
        "extensionForge.author": {
          "type": "string",
          "default": "",
          "description": "%config.author%"
        },
        "extensionForge.publisher": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.publisher%"
        }
      }
    }
  },
  "scripts": {
    "copy-skill": "node -e \"const fs=require('fs');fs.rmSync('skill',{recursive:true,force:true});fs.cpSync('../skills/extension-vscode','skill',{recursive:true})\"",
    "build": "npm run copy-skill && esbuild src/extension.ts src/server.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --outdir=out --minify --keep-names",
    "typecheck": "tsc -p . --noEmit",
    "compile": "npm run typecheck && npm run build && tsc -p tsconfig.test.json",
    "vscode:prepublish": "npm run compile",
    "test": "npm run compile && node --test out-test/test/*.test.js",
    "test:integration": "npm run compile && node out-test/integration/runTest.js",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "^26.6.6",
    "@types/vscode": "~1.101.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  }
}
